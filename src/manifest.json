{
  "manifest_version": 3,
  "name": "Feed Lens — Feed Filter for LinkedIn and X",
  "version": "0.1.0",
  "description": "Shows only the LinkedIn and X feed posts you care about. An AI hides the rest.",
  "permissions": ["storage", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://x.com/*",
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://x.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Feed Lens",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
